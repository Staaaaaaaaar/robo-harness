# PR 01 CPU development baseline.
RH_UBUNTU_VERSION=22.04
RH_ROS_DISTRO=humble
RH_PYTHON_VERSION=3.10
RH_ROS_BASE_IMAGE=public.ecr.aws/docker/library/ros:humble-ros-base-jammy@sha256:7bea3d9aa2483d3ca34c8e30d921b79273b0913bd7dc64bebf51d082b5d107e4
RH_DEV_IMAGE=roboharness-dev:humble
RH_MOCK_RUNTIME_IMAGE=roboharness-mock-runtime:humble
RH_MOCK_ROS_DOMAIN_ID=42

# Toolchain versions verified for PR 01. The container base and package
# repositories remain the installation authority.
RH_VALIDATED_DOCKER_ENGINE_VERSION=29.7.2
RH_VALIDATED_DOCKER_COMPOSE_VERSION=5.4.0
RH_VALIDATED_GCC_VERSION=11.4.0
RH_VALIDATED_CMAKE_VERSION=3.22.1
RH_VALIDATED_MAKE_VERSION=4.3
RH_VALIDATED_COLCON_CORE_VERSION=0.21.0
RH_VALIDATED_RUFF_VERSION=0.11.13

# The Isaac runtime baseline is selected for the Ubuntu 22.04 / ROS 2 Humble
# project platform. PR 13 validates the exact image digest, host driver, and
# GPU runtime; do not infer those from the CPU development image.
RH_ISAAC_SIM_VERSION=4.5.0
RH_ISAAC_REFERENCE_ROBOT=anymal_c

# The MVP deploys the ANYmal C policy bundled with Isaac Sim. Isaac Lab is not
# installed in the runtime image; add and pin it only if policy training or
# export becomes a confirmed requirement.
